.espace-employe {
  width: min(1100px, 92%);
  margin: 3rem auto;
}

h1 {
  margin-bottom: 0.75rem;
}

.liste-commandes {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.25rem;
  margin-top: 2rem;
}

.commande {
  padding: 1.5rem;
  border: 1px solid var(--admin-bordure);
  border-radius: 8px;
  background: #fff;
  overflow-wrap: anywhere;
}

.commande h2 {
  margin-top: 0;
  margin-bottom: 1rem;
}

.commande p {
  margin: 0.65rem 0;
  line-height: 1.5;
}

.erreur {
  color: #b42318;
  margin-top: 1rem;
}

.gestion {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--admin-bordure);
}

.gestion h3 {
  margin: 0 0 0.5rem;
}

.gestion label {
  font-weight: 600;
  font-size: 0.9rem;
}

.gestion select,
.gestion textarea {
  width: 100%;
}

.gestion button {
  padding: 0.75rem 1rem;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  font: inherit;
  font-weight: 600;
  background: var(--admin-vert);
  color: white;
}

.gestion button:disabled {
  opacity: 0.6;
  cursor: wait;
}

.gestion .bouton-annulation {
  background: #a52a2a;
}

.message {
  color: #216e39;
  margin-top: 1rem;
}

@media (max-width: 600px) {
  .espace-employe {
    margin: 1.5rem auto;
  }

  .commande {
    padding: 1rem;
  }
}


.outils-commandes {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 1rem;
  align-items: end;
  margin-top: 1.5rem;
  padding: 1.25rem;
  border: 1px solid var(--admin-bordure);
  border-radius: 8px;
  background: var(--admin-fond-formulaire);
}

.outils-commandes > div {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
}

.outils-commandes label {
  font-size: 0.9rem;
  font-weight: 600;
}

.outils-commandes input,
.outils-commandes select {
  width: 100%;
  min-width: 0;
  background: white;
}

.compteur-commandes,
.aucun-resultat {
  margin: 0;
  align-self: center;
}


.ligne-statut {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.6rem;
}

.badge-statut {
  display: inline-flex;
  align-items: center;
  padding: 0.3rem 0.65rem;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 700;
  line-height: 1.35;
}

.statut-attente {
  background: #fff1c2;
  color: #754b00;
}

.statut-acceptee,
.statut-livree {
  background: #d9f2e3;
  color: #175c37;
}

.statut-preparation {
  background: #dceafe;
  color: #174a8b;
}

.statut-livraison {
  background: #e9ddff;
  color: #542d91;
}

.statut-terminale {
  background: #eeeeee;
  color: #555555;
}

.statut-neutre {
  background: #eeeeee;
  color: #333333;
}

.commande.prestation-proche {
  border-color: #d97706;
  box-shadow: 0 0 0 1px #d97706;
}

.alerte-prestation {
  padding: 0.7rem;
  border-radius: 5px;
  background: #fff1dc;
  color: #7c3f00;
  font-weight: 700;
}

.onglets-employe {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin: 1.5rem 0;
  border-bottom: 1px solid var(--admin-bordure);
  padding-bottom: 1rem;
}

.onglets-employe button.actif {
  background: var(--admin-vert-fonce);
  outline: 2px solid var(--admin-vert-clair);
}

.gestion-catalogue {
  margin: 1.5rem 0 2rem;
}

.formulaire-catalogue {
  display: grid;
  gap: 0.65rem;
  max-width: 720px;
  margin: 1rem 0 2rem;
  padding: 1.25rem;
  border: 1px solid var(--admin-bordure);
  border-radius: 8px;
  background: var(--admin-fond-formulaire);
}

.formulaire-catalogue input:not([type="checkbox"]),
.formulaire-catalogue select,
.formulaire-catalogue textarea {
  width: 100%;
}

.formulaire-catalogue fieldset {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem;
  border: 1px solid #ccc;
  border-radius: 5px;
}

.choix-allergene {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
}

.carte-menu-gestion {
  margin: 1rem 0;
  padding: 1rem;
  border: 1px solid var(--admin-bordure);
  border-radius: 8px;
  background: #fff;
}

.carte-menu-gestion button {
  margin: 0.3rem 0.5rem 0.3rem 0;
}


/* Harmonisation des horaires avec l'espace administrateur */
.gestion-catalogue .carte-statistique {
  min-width: 0;
  padding: 1.5rem;
  margin: 1rem 0;
}

.gestion-catalogue .carte-statistique h3,
.composition-menu h4,
.creation-plat-integree h4 {
  margin-top: 0;
  margin-bottom: 1rem;
}

.gestion-catalogue .carte-statistique label:not(.toggle-fermeture) {
  display: block;
  margin: 0.6rem 0;
  font-size: 0.9rem;
  font-weight: 600;
}

.gestion-catalogue .carte-statistique input:not([type="checkbox"]) {
  height: 46px;
  background: #fff;
  color: #302a25;
}

/* Même disposition des cartes horaires que dans l'espace administrateur */
.espace-employe .formulaire-horaires {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
  gap: 1rem;
  width: 100%;
  max-width: none;
  box-sizing: border-box;
}

.espace-employe .formulaire-horaires > .carte-statistique {
  margin: 0;
  min-width: 0;
}

.espace-employe .formulaire-horaires > button {
  grid-column: 1 / -1;
  justify-self: start;
}

@media (max-width: 900px) {
  .espace-employe .formulaire-horaires {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .espace-employe .formulaire-horaires {
    grid-template-columns: 1fr;
  }
}
