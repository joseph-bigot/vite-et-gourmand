
<section class="menus-page">
  <h1>Tous nos menus</h1>
  <p>Découvrez les menus proposés par Vite &amp; Gourmand.</p>

  <div class="menus-filtres">
    <label for="prixMin">Prix minimum (€)</label>
    <input
      id="prixMin"
      type="number"
      min="0"
      placeholder="Ex. : 25"
      [value]="prixMin"
      (input)="changerPrixMin($event)"
    />

    <label for="prixMax">Prix maximum (€)</label>
    <input
      id="prixMax"
      type="number"
      min="0"
      placeholder="Ex. : 45"
      [value]="prixMax"
      (input)="changerPrixMax($event)"
    />

    <label for="theme">Thème</label>
    <select
      id="theme"
      [value]="theme"
      (change)="changerTheme($event)"
    >
      <option value="">Tous les thèmes</option>
      <option value="Classique">Classique</option>
      <option value="Noël">Noël</option>
      <option value="Pâques">Pâques</option>
      <option value="Événement">Événement</option>
    </select>

    <label for="regime">Régime alimentaire</label>
    <select
      id="regime"
      [value]="regime"
      (change)="changerRegime($event)"
    >
      <option value="">Tous les régimes</option>
      <option value="Classique">Classique</option>
      <option value="Végétarien">Végétarien</option>
      <option value="Sans gluten">Sans gluten</option>
    </select>

    <label for="nombrePersonnes">Nombre de personnes</label>
    <input
      id="nombrePersonnes"
      type="number"
      min="1"
      placeholder="Ex. : 10"
      [value]="nombrePersonnes"
      (input)="changerNombrePersonnes($event)"
    />

    <button type="button" (click)="reinitialiserFiltres()">
      Réinitialiser les filtres
    </button>
  </div>

  <p *ngIf="erreur" class="erreur">{{ erreur }}</p>
  <p *ngIf="chargement">Chargement des menus...</p>

  <div class="menus-grid" *ngIf="!chargement && menus.length > 0">
    <article class="menu-card" *ngFor="let menu of menus">
      <img
        class="menu-image"
        [src]="
          menu.theme === 'Noël' || menu.theme === 'Événement'
            ? '/images/menu-festif.png'
            : '/images/menu-classique.png'
        "
        [alt]="'Illustration du ' + menu.titre"
      />

      <div class="menu-card-content">
        <h2>{{ menu.titre }}</h2>
        <p>{{ menu.description }}</p>
        <p>
          Minimum {{ menu.nombre_minimum_personnes }} personnes
        </p>
        <p class="menu-prix">
          À partir de {{ menu.prix_par_personne }} € / personne
        </p>
        <p class="menu-indisponible" *ngIf="menu.stock <= 0">
          Indisponible
        </p>
      </div>

      <a
  class="menu-details"
  [routerLink]="['/menus', menu.id_menu]"
>
  Voir le menu
</a>
    </article>
  </div>

  <p *ngIf="!chargement && !erreur && menus.length === 0">
    Aucun menu ne correspond à vos critères.
  </p>
</section>
